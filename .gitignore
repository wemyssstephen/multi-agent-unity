# ─── Secrets ───────────────────────────────────────────────
.env
.env.*
!.env.example

# ─── Python ────────────────────────────────────────────────
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.ruff_cache/
build/
dist/

# ─── Editors ───────────────────────────────────────────────
.vscode/
.idea/

# ─── OS ────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ─── Project outputs ───────────────────────────────────────
# /runs/
# /results/
# *.log

# Ignore the entire Unity project except the bridge code
/unity/*
!/unity/Assets/
/unity/Assets/*
!/unity/Assets/MultiAgentBridge/
!/unity/Assets/MultiAgentBridge/**

# Working/ is per-run scratch — keep the folder, ignore its contents
/unity/Assets/MultiAgentBridge/Working/*
!/unity/Assets/MultiAgentBridge/Working/.gitkeep

# Unity package manifest
!/unity/Packages/
/unity/Packages/*
!/unity/Packages/manifest.json